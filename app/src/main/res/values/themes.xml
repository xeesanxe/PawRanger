<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.PawRanger" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="bottomNavigationStyle">@style/CustomBottomNav</item>
    </style>

    <style name="CustomBottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="itemActiveIndicatorStyle">@style/App.Custom.Indicator</item>
    </style>

    <style name="Theme.PawRanger" parent="Base.Theme.PawRanger" />

    <style name="CircleShape">
        <item name="cornerSize">50%</item>
    </style>

    <style name="App.Custom.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/status_green</item>
        <item name="android:width">52dp</item>
        <item name="android:height">44dp</item>
        <item name="shapeAppearance">@style/NavIndicatorShape</item>
    </style>

    <style name="NavIndicatorShape">
        <item name="cornerSize">12dp</item>
    </style>

    <style name="NavTextActive">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/status_green</item>
    </style>

    <style name="NavTextInactive">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/gray_text</item>
    </style>
</resources>
