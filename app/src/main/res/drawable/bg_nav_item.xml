<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <layer-list>
            <!-- Background kapsul lembut di belakang ikon -->
            <item android:gravity="top|center_horizontal" android:top="6dp" android:width="48dp" android:height="30dp">
                <shape>
                    <solid android:color="#1A0A84FF" />
                    <corners android:radius="15dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>